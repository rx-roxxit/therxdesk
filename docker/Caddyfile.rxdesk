# The RX Desk — Caddy in front of all three parts (see compose.rxdesk.yaml).
#
#   {$APP_DOMAIN}         the main app (this stack)
#   admin.{$SITE_DOMAIN}  the admin app's stack
#   {$SITE_DOMAIN}        the website's stack
#   www.{$SITE_DOMAIN}    301 to the apex
#
# Caddy gets each certificate on its own (Let's Encrypt) and passes WebSocket
# upgrades (Reverb, /app) through. It sits directly on the internet, so it
# replaces any X-Forwarded-For a client sends; the app trusts Caddy's fixed
# address only.
#
# The admin and site stacks join this stack's `edge` network as an external
# network, so their `admin` and `site` services resolve here. Start the main
# app stack first: it creates `edge` and `api`.
#
# /internal is the main app's internal API. It lives on the `api` network and
# must never be reachable from the internet, on any host.

(internal) {
	@internal path /internal /internal/*
	respond @internal 404
}

(web) {
	encode zstd gzip
	import internal
}

{$APP_DOMAIN} {
	import web

	# Cashier's webhook POST /stripe/webhook is proxied: its signature is
	# checked with STRIPE_WEBHOOK_SECRET.
	reverse_proxy app:80
}

admin.{$SITE_DOMAIN} {
	import web
	reverse_proxy admin:80
}

{$SITE_DOMAIN} {
	import web
	reverse_proxy site:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
