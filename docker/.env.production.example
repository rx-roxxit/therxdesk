# The RX Desk — production settings for compose.rxdesk.yaml.
#
#   cp docker/.env.production.example .env.production   (git-ignored)
#   docker compose -f compose.rxdesk.yaml --env-file .env.production build
#   docker compose -f compose.rxdesk.yaml --env-file .env.production up -d
#
# Every value below is a placeholder. Never commit the filled-in file.
# VITE_* build settings (app name, Reverb key, domain) are baked into the image
# when it is built: after changing APP_NAME, REVERB_APP_KEY or APP_DOMAIN,
# build again.

# ===== Required =====
# Public domain, no scheme. DNS must point at the VPS; Caddy gets the
# certificate on its own. APP_URL and every redirect URI are built from it.
APP_DOMAIN=desk.example.com
APP_NAME="The RX Desk"
# docker compose -f compose.rxdesk.yaml --env-file .env.production run --rm --no-deps app php artisan key:generate --show
APP_KEY=base64:change-me

# ===== Networking =====
# Caddy's fixed address and the private subnet it sits in. TRUSTED_PROXIES in
# the app is set to exactly CADDY_IP. Change them together, and only when the
# range clashes with another network on the VPS (use a private range).
CADDY_IP=172.30.0.10
EDGE_SUBNET=172.30.0.0/24
EDGE_DYNAMIC_RANGE=172.30.0.128/25
EDGE_GATEWAY=172.30.0.1

# ===== The RX Desk =====
# Quota of an Owner without one of their own (rxdesk:quota changes one).
RXDESK_DEFAULT_QUOTA=5GB
# Under this much free disk, every upload and import is refused (Disk guard).
RXDESK_DISK_GUARD_THRESHOLD=10GB
# Not settable here, set by the compose file: the legal links point at the
# app's own /privacy and /terms (resources/legal); SELF_HOSTED is true;
# POSTHOG_ENABLED, NIGHTWATCH_ENABLED, CHANGELOG_ENABLED, TELESCOPE_ENABLED,
# GOOGLE_AUTH_ENABLED and GITHUB_AUTH_ENABLED are false.

# ===== Database =====
DB_DATABASE=therxdesk
DB_USERNAME=therxdesk
DB_PASSWORD=change-me

# ===== WebSockets (Reverb) =====
REVERB_APP_ID=1001
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret

# ===== Passport (API keys / MCP) =====
# Generate once, on the host:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 > private.pem
#   openssl pkey -in private.pem -pubout > public.pem
# Paste each PEM on one line with \n for the line breaks, inside double quotes,
# then delete the two files.
# Keep them forever: new keys invalidate every API and MCP token.
PASSPORT_PRIVATE_KEY="change-me"
PASSPORT_PUBLIC_KEY="change-me"

# ===== Mail =====
# "log" writes emails to the container log: Invites and password resets need smtp.
# MAIL_SCHEME is smtp (STARTTLS on 587) or smtps (TLS on 465); "tls" is refused.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=hello@example.com

# ===== Social platforms =====
# Redirect URIs to register in each portal (https://<APP_DOMAIN>...):
#   Facebook   /accounts/facebook/callback      Instagram  /accounts/instagram/callback
#   Threads    /accounts/threads/callback       TikTok     /accounts/tiktok/callback
#   YouTube    /accounts/youtube/callback       LinkedIn   /accounts/linkedin/callback, /accounts/linkedin-page/callback
#   X          /accounts/x/callback             Pinterest  /accounts/pinterest/callback
# Each of these networks stays off (not offered on Channels) until its
# credentials are below and its switch is true. Instagram has two ways in:
# INSTAGRAM (Instagram Login) and INSTAGRAM_FACEBOOK (through a Facebook Page).
FACEBOOK_ENABLED=false
INSTAGRAM_ENABLED=false
INSTAGRAM_FACEBOOK_ENABLED=false
THREADS_ENABLED=false
TIKTOK_ENABLED=false
YOUTUBE_ENABLED=false
LINKEDIN_ENABLED=false
LINKEDIN_PAGE_ENABLED=false
X_ENABLED=false
PINTEREST_ENABLED=false
GOOGLE_BUSINESS_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Google project for YouTube publishing (not for signup: GOOGLE_AUTH_ENABLED stays false).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ===== Google Drive: composer picker and the Video policy backup =====
# A separate Google Cloud OAuth client (Web application). Register both
# redirect URIs on it:
#   https://<APP_DOMAIN>/integrations/google/callback           (the picker)
#   https://<APP_DOMAIN>/settings/preferences/drive/callback    (the backup)
GOOGLE_MEDIA_CLIENT_ID=
GOOGLE_MEDIA_CLIENT_SECRET=
GOOGLE_MEDIA_API_KEY=
GOOGLE_MEDIA_APP_ID=
# The composer's "Import from Google Drive" picker, off by default. The Video
# policy's Drive backup needs only the client id and secret above, so it
# works with the picker off. Set true to offer the picker too (it also needs
# GOOGLE_MEDIA_API_KEY and GOOGLE_MEDIA_APP_ID).
GOOGLE_DRIVE_ENABLED=false

# ===== AI (optional: leave blank to disable) =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
